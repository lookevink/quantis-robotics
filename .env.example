# The existing EBS-backed EC2 GPU host to start and stop.
AWS_INSTANCE_ID=i-0123456789abcdef0
AWS_REGION=us-east-1
AWS_SSH_PRIVATE_KEY=/absolute/path/to/key.pem

# Optional when the instance has more than one security group.
# AWS_SECURITY_GROUP_ID=sg-0123456789abcdef0

# Optional overrides.
# AWS_SSH_USER=ubuntu
# WEBRTC_SOURCE_CIDR=203.0.113.10/32
# ISAAC_SIM_VERSION=6.0.1
# ISAAC_SIGNAL_PORT=49100
# ISAAC_STREAM_PORT=47998
# DOWNLOAD_PHYSICALAI_DATASET=0
# HF_DOWNLOAD_MAX_WORKERS=32
